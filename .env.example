# Copy this file to .env and fill in the values. The real .env is never committed.

# PostgreSQL connection strings. DIRECT_URL points at the non-pooled connection on Supabase;
# on a local server the same value can be used for both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Signs the session cookie. At least 32 characters, otherwise nobody can sign in.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MUBEA_SESSION_SECRET=""

# Personal access codes: one scrypt hash per technician ID number.
# Escape every "$" as "\$", otherwise the value is truncated and no code can ever match.
# Create the manager account with:
#   node --env-file=.env scripts/create-admin.mjs "ADMIN" "ADMIN-001" "the chosen code"
MUBEA_TECHNICIAN_CODES={}

# Optional shared workshop code (scrypt hash). It never opens an ADMIN profile.
MUBEA_ACCESS_CODE_HASH=""
