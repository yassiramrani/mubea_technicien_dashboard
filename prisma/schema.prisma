generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Technician {
  id        String   @id @default(cuid())
  name      String
  idNumber  String   @unique
  // "TECHNICIAN" (default) takes and returns tools.
  // "LABELER" is the identification profile: it can only rename tools and attach
  // their photos — no TAKEN/RETURNED movements are recorded for it.
  role      String   @default("TECHNICIAN")
  createdAt DateTime @default(now())
  tools     Tool[]
  logs      Log[]
}

model Tool {
  id           String      @id @default(cuid())
  qrCode       String      @unique
  name         String
  image        String?     // Optional image field (URL or base64)
  status       String      @default("AVAILABLE") // "AVAILABLE", "ASSIGNED"
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id])
  logs         Log[]
  // Label print tracking: lets the app know which labels were already printed
  // (and successfully stuck on a tool) so a partial or bad print run can be
  // resumed without re-printing — or re-identifying — the whole inventory.
  labelPrinted Boolean     @default(false)
  labelPrintedAt DateTime?
  createdAt    DateTime    @default(now())
}

model Log {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  toolId       String
  tool         Tool       @relation(fields: [toolId], references: [id])
  action       String     // "TAKEN", "RETURNED"
  createdAt    DateTime   @default(now())
}
